# ===== Claw-brain 配置 =====
# 复制此文件为 .env 并填写你的配置

# --- AI 大脑 (LLM) ---
# DeepSeek API Key (注册: https://platform.deepseek.com)
BRAIN_API_KEY=your-api-key-here

# API 地址 (默认 DeepSeek，也支持 OpenAI 兼容接口)
BRAIN_BASE_URL=https://api.deepseek.com/v1

# 模型名称
BRAIN_MODEL=deepseek-chat

# --- OpenClaw ---
# Gateway 地址 (默认本地)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# OpenClaw 使用的 Agent 名称
OPENCLAW_AGENT=main

# (可选) 指定 Node.js 目录，留空则使用系统 PATH 中的 node/openclaw
# OPENCLAW_NODE_DIR=
